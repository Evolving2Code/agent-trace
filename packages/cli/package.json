{
  "name": "@evolving2code/agent-trace",
  "version": "0.1.0",
  "description": "Browser DevTools for AI agents — record, replay, and fork agent runs",
  "type": "module",
  "bin": {
    "agent-trace": "./dist/index.js"
  },
  "files": [
    "dist",
    "viewer-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "prepack": "node ../../scripts/prepare-publish.mjs"
  },
  "dependencies": {
    "@evolving2code/agent-trace-core": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evolving2Code/agent-trace.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Evolving2Code/agent-trace/issues"
  },
  "homepage": "https://github.com/Evolving2Code/agent-trace#readme",
  "author": "Victor",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agent",
    "observability",
    "replay",
    "cursor",
    "cli",
    "devtools",
    "coding-agent"
  ]
}
