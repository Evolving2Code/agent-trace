{
  "name": "@evolving2code/agent-trace-core",
  "version": "0.1.1",
  "description": "Event-sourced trace store and replay engine for AI agent runs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/cursor/parser.test.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "nanoid": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evolving2Code/agent-trace.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Evolving2Code/agent-trace/issues"
  },
  "homepage": "https://github.com/Evolving2Code/agent-trace#readme",
  "author": "Victor",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agent",
    "observability",
    "replay",
    "cursor",
    "sqlite",
    "trace",
    "devtools"
  ]
}
